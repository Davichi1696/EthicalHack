Quick Deployment Instructions

1. Open a terminal and create a new file: nano openvas_start.sh

2. Paste the code block above into the file.

3. Save and close (Ctrl+O, Enter, then Ctrl+X).

4. Give the file executable permissions:bash
chmod +x openvas_start.sh

5. Execute it with administrative rights:bash
sudo ./openvas_start.sh


################################### CODE ###################################################

#!/bin/bash

# ==============================================================================
# OpenVAS (GVM) Docker Startup Script
# Default Image Credentials: Username: admin | Password: admin
# ==============================================================================

# Run as root
if [ "$(id -u)" -ne 0 ]; then
    echo "Please run as root"
    exit 1
fi

# Check if Docker is installed
if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is not installed. Please install Docker first."
    exit 1
fi

# Define container/image name
CONTAINER_NAME="openvas"
IMAGE_NAME="mikesplain/openvas"

# Check if any container is running OpenVAS on port 443
RUNNING_CONTAINER=$(docker ps --filter "publish=443" --format "{{.Names}}" | head -n 1)

if [ -n "$RUNNING_CONTAINER" ]; then
    echo "OpenVAS is already running in container '$RUNNING_CONTAINER'. Opening UI..."
    su $(logname) -c 'chromium --ignore-certificate-errors https://127.0.0.1/ &'
    exit 0
fi

# Start existing container or run new one
if [ "$(docker ps -aq -f name=${CONTAINER_NAME})" ]; then
    echo "Starting existing container..."
    docker start "$CONTAINER_NAME"
else
    echo "Launching new OpenVAS container..."
    docker run -d -p 443:443 --name "$CONTAINER_NAME" "$IMAGE_NAME"
fi

# Wait for it to boot up
echo "Waiting for OpenVAS to initialize (30 seconds)..."
sleep 30

# Launch Chromium to localhost OpenVAS
echo "Opening OpenVAS in Chromium..."
su $(logname) -c 'chromium --ignore-certificate-errors https://127.0.0.1/ &'

exit 0

